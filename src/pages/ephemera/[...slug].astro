---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, prettyDate } from '../../lib/feed';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="page-head">
      <h1>{post.data.title}</h1>
      <p>{prettyDate(post.data.date)}</p>
    </header>
    <div class="prose"><Content /></div>
    <nav class="pn small">
      {older ? <a href={`/ephemera/${older.id}/`}>← {older.data.title}</a> : <span />}
      {newer ? <a href={`/ephemera/${newer.id}/`}>{newer.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>
<style>
  .pn { display: flex; justify-content: space-between; gap: 1rem; max-width: var(--measure); margin-top: 4rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .pn a { text-decoration: none; color: var(--ink-soft); }
  .pn a:hover { color: var(--ink); }
</style>
