---
import Base from '../../layouts/Base.astro';
import { getPosts, prettyDate } from '../../lib/feed';
const posts = await getPosts();
---
<Base title="ephemera" description="Things I wrote down.">
  <header class="page-head">
    <h1>ephemera</h1>
    <p>Things I wrote down.</p>
  </header>
  <ul class="plain-list posts">
    {posts.map((p) => (
      <li>
        <a href={`/ephemera/${p.id}/`}>{p.data.title}</a>
        <span class="soft small">{prettyDate(p.data.date)}</span>
      </li>
    ))}
  </ul>
</Base>
<style>
  .posts { max-width: var(--measure); }
  li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule); }
  li a { text-decoration: none; font-size: 1.25rem; }
  li a:hover { text-decoration: underline; }
  li span { white-space: nowrap; }
  @media (max-width: 520px) { li { flex-direction: column; gap: 0.1rem; } }
</style>
