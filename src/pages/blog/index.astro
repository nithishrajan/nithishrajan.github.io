---
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime, isoDate } from '../../lib/feed';
const posts = await getPosts();
// group by year, changelog style
const years = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), p]);
}
---
<Base title="logs" description="Thoughts, written down before they were finished.">
  <header class="section-head">
    <p class="label">~/logs</p>
    <h1>Logs</h1>
    <p>Thoughts, written down before they were finished.</p>
  </header>
  {[...years].map(([year, list]) => (
    <section class="year">
      <h2 class="mono amber">## {year}</h2>
      <ol>
        {list.map((p) => (
          <li>
            <span class="mono soft date">{isoDate(p.data.date)}</span>
            <div>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <p class="desc">{p.data.description}</p>
              <p class="mono soft meta">
                {readingTime(p.body)} min read
                {p.data.tags.map((t) => <> · <a href={`/tags/${t}/`}>#{t}</a></>)}
                {p.data.draft && <> · <span class="amber">draft</span></>}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
<style>
  .year h2 { font-size: 0.9rem; margin: 2.5rem 0 1rem; }
  ol { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px dashed var(--rule); }
  .date { font-size: 0.78rem; padding-top: 0.35rem; }
  li > div > a { font-size: 1.35rem; text-decoration: none; }
  li > div > a:hover { text-decoration: underline; }
  .desc { margin: 0.2rem 0; color: var(--ink-soft); }
  .meta { margin: 0; font-size: 0.72rem; }
  .meta a { text-decoration: none; }
  @media (max-width: 520px) { li { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
