---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { photosIn } from '../lib/feed';

// Curate the front page by adding photos to src/assets/home/ — they show in filename order.
const photos = photosIn('home');
---
<Base>
  <div class="stream">
    {photos.map((src, i) => (
      <figure>
        <Image
          src={src}
          alt=""
          widths={[640, 1100, 1600]}
          sizes="(max-width: 900px) 100vw, 900px"
          loading={i < 2 ? 'eager' : 'lazy'}
        />
      </figure>
    ))}
  </div>
</Base>
<style>
  .stream { display: flex; flex-direction: column; align-items: center; gap: clamp(3rem, 12vh, 8rem); padding: 2rem 0 4rem; }
  figure { margin: 0; width: 100%; max-width: 900px; display: flex; justify-content: center; }
  figure :global(img) { max-height: 88vh; width: auto; object-fit: contain; }
  /* portrait photos stay narrower, landscapes fill the column */
</style>
