---
import Base from '../layouts/Base.astro';
import Greeting from '../components/Greeting.astro';
import NowBlock from '../components/NowBlock.astro';
import LifeLog from '../components/LifeLog.astro';
import ArchivePick from '../components/ArchivePick.astro';
import PrintScatter from '../components/PrintScatter.astro';
import SurpriseMe from '../components/SurpriseMe.astro';
import { getFeed, getEphemera } from '../lib/feed';

const feed = await getFeed();
const recent = feed.slice(0, 8);
// anything that isn't in the top 3 is fair game for the archive
const archive = feed.slice(3);
const prints = (await getEphemera()).slice(0, 4);
---
<Base>
  <section class="hero">
    <Greeting />
    <p class="intro">
      I write things down, take pictures of light on walls, and keep too many books.
      This is where all of it ends up, in whatever order it happened.
    </p>
    <SurpriseMe />
  </section>

  <div class="board">
    <section class="log-col" aria-labelledby="log-h">
      <h2 id="log-h" class="label">git log --all --since=forever</h2>
      <LifeLog items={recent} />
    </section>
    <aside class="side">
      <NowBlock />
      <ArchivePick items={archive} />
    </aside>
  </div>

  <section class="on-desk" aria-labelledby="desk-h">
    <h2 id="desk-h" class="label">on the desk lately — <a href="/ephemera/">see all</a></h2>
    <PrintScatter items={prints} />
  </section>
</Base>

<style>
  .hero { margin-bottom: 3.5rem; }
  .intro { max-width: 34rem; color: var(--ink-soft); margin: 0 0 1.5rem; }
  .board { display: grid; grid-template-columns: 1fr 19rem; gap: 3rem; align-items: start; }
  .board > * { min-width: 0; }
  .side { display: flex; flex-direction: column; gap: 2rem; }
  .log-col h2, .on-desk h2 { margin: 0 0 1rem; }
  .on-desk { margin-top: 4.5rem; }
  @media (max-width: 820px) {
    .board { grid-template-columns: 1fr; }
    .side { order: -1; }
  }
</style>
