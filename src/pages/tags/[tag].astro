---
import Base from '../../layouts/Base.astro';
import { getPosts, getBooks, isoDate } from '../../lib/feed';

export async function getStaticPaths() {
  const [posts, books] = await Promise.all([getPosts(), getBooks()]);
  const tags = new Set([...posts, ...books].flatMap((e) => e.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
      books: books.filter((b) => b.data.tags.includes(tag)),
    },
  }));
}
const { tag } = Astro.params;
const { posts, books } = Astro.props;
---
<Base title={`#${tag}`}>
  <header class="section-head">
    <p class="label">grep -r "#{tag}"</p>
    <h1>#{tag}</h1>
  </header>
  <ul class="mono">
    {posts.map((p) => <li><span class="soft">log · {isoDate(p.data.date)}</span> <a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
    {books.map((b) => <li><span class="soft">book</span> <a href={`/books/${b.id}/`}>{b.data.title}</a></li>)}
  </ul>
</Base>
<style>
  ul { list-style: none; padding: 0; font-size: 0.85rem; }
  li { padding: 0.5rem 0; border-bottom: 1px dashed var(--rule); }
  a { font-family: var(--serif); font-size: 1.1rem; margin-left: 0.5rem; }
</style>
