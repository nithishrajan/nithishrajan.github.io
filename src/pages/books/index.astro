---
import Base from '../../layouts/Base.astro';
import BookSpine from '../../components/BookSpine.astro';
import Rating from '../../components/Rating.astro';
import { getBooks } from '../../lib/feed';

const books = await getBooks();
const byDate = (a: (typeof books)[number], b: (typeof books)[number]) =>
  (b.data.dateRead?.valueOf() ?? 0) - (a.data.dateRead?.valueOf() ?? 0);
const shelves = [
  { key: 'reading', label: 'on the nightstand', list: books.filter((b) => b.data.status === 'reading') },
  { key: 'read', label: 'read', list: books.filter((b) => b.data.status === 'read').sort(byDate) },
  { key: 'want', label: 'one day', list: books.filter((b) => b.data.status === 'want') },
].filter((s) => s.list.length);
const recs = books.filter((b) => b.data.recommended).sort(byDate);
---
<Base title="books" description="The shelf: what I'm reading, what I loved, what's next.">
  <header class="section-head">
    <p class="label">~/books</p>
    <h1>The shelf</h1>
    <p>Pull a spine to read what I thought. The ones marked <em class="rec">rec’d!</em> I'd press into your hands.</p>
    <button class="btn pick" type="button" data-pick><span class="prompt">$</span> pick my next read</button>
    <p class="mono soft picked-msg" data-pick-msg aria-live="polite"></p>
  </header>

  {shelves.map((s) => (
    <section class="shelf-section">
      <h2 class="label">{s.label} ({s.list.length})</h2>
      <ul class="shelf">
        {s.list.map((b) => <BookSpine book={b} />)}
      </ul>
    </section>
  ))}

  {recs.length > 0 && (
    <section class="recs">
      <h2 class="label">if you only read one</h2>
      <ul>
        {recs.map((b) => (
          <li>
            <a href={`/books/${b.id}/`}><em>{b.data.title}</em></a> <span class="soft">— {b.data.author}</span>
            <div class="mono soft"><Rating value={b.data.rating} /> {b.data.blurb}</div>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
<script>
  // pick a random book from "one day" + recommended, and lift its spine
  const btn = document.querySelector('[data-pick]');
  const msg = document.querySelector<HTMLElement>('[data-pick-msg]');
  btn?.addEventListener('click', () => {
    const pool = [...document.querySelectorAll<HTMLAnchorElement>('[data-book]')].filter(
      (a) => a.dataset.status === 'want' || a.dataset.rec,
    );
    if (!pool.length || !msg) return;
    document.querySelectorAll('.picked').forEach((e) => e.classList.remove('picked'));
    const pick = pool[Math.floor(Math.random() * pool.length)];
    pick.classList.add('picked');
    pick.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
    const title = pick.querySelector('.t')?.textContent;
    msg.innerHTML = `→ the shelf says: <a href="${pick.getAttribute('href')}">${title}</a>`;
  });
</script>
<style>
  .rec { color: var(--terracotta); }
  .pick { margin-top: 1.25rem; }
  .picked-msg { min-height: 1.2em; font-size: 0.8rem; }
  .shelf-section { margin: 3rem 0; }
  .shelf {
    display: flex; align-items: flex-end; gap: 4px; padding: 2.2rem 0.75rem 0; margin: 0.5rem 0 0;
    border-bottom: 10px solid #7a5232;
    box-shadow: 0 12px 14px -10px rgba(60, 40, 20, 0.45);
    overflow-x: auto; min-height: 280px;
    background: linear-gradient(transparent 92%, rgba(0,0,0,.04));
  }
  .recs ul { list-style: none; padding: 0; }
  .recs li { padding: 0.8rem 0; border-bottom: 1px dashed var(--rule); }
  .recs a { text-decoration: none; font-size: 1.2rem; }
  .recs .mono { font-size: 0.75rem; margin-top: 0.2rem; }
</style>
