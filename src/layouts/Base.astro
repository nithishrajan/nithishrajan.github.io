---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import SurpriseMe from '../components/SurpriseMe.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title, description = 'Writing, ephemera, and books. Nothing here is finished.' } = Astro.props;
const siteName = '~/site';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const path = Astro.url.pathname;
const nav = [
  { href: '/blog/', label: 'logs' },
  { href: '/ephemera/', label: 'ephemera' },
  { href: '/books/', label: 'books' },
  { href: '/about/', label: 'about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="logs" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="wrap top">
      <a href="/" class="home mono" aria-label="home">
        <span class="amber">~</span>/site<span class="cursor" aria-hidden="true"></span>
      </a>
      <nav class="mono" aria-label="main">
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
            <span class="slash">~/</span>{n.label}
          </a>
        ))}
      </nav>
      <button class="theme mono" type="button" data-theme-toggle aria-label="toggle light/dark">◐</button>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap foot mono soft">
      <span>made by hand, mostly. <a href="/rss.xml">rss</a></span>
      <SurpriseMe label="take me somewhere" />
    </footer>

    <script>
      // ── relative time: "3 days ago" ────────────────────────────
      const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
      const units: [Intl.RelativeTimeFormatUnit, number][] = [
        ['year', 31536e6], ['month', 2592e6], ['week', 6048e5], ['day', 864e5], ['hour', 36e5], ['minute', 6e4],
      ];
      document.querySelectorAll<HTMLTimeElement>('time[data-relative]').forEach((el) => {
        const diff = new Date(el.dateTime).getTime() - Date.now();
        for (const [unit, ms] of units) {
          if (Math.abs(diff) >= ms || unit === 'minute') {
            el.textContent = rtf.format(Math.round(diff / ms), unit);
            break;
          }
        }
      });

      // ── surprise me: random jump anywhere ─────────────────────
      let index: string[] | null = null;
      async function surprise() {
        try {
          index ??= (await (await fetch('/random.json')).json()) as string[];
          const options = index.filter((u) => u !== location.pathname);
          if (options.length) location.href = options[Math.floor(Math.random() * options.length)];
        } catch {
          /* offline or missing index: stay put */
        }
      }
      document.querySelectorAll('[data-surprise]').forEach((b) => b.addEventListener('click', surprise));
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key !== 'r' || e.metaKey || e.ctrlKey || e.altKey) return;
        if (t.closest('input, textarea, [contenteditable]')) return;
        surprise();
      });

      // ── theme toggle ──────────────────────────────────────────
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>

    <style>
      .top {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        flex-wrap: wrap;
      }
      .home { text-decoration: none; font-weight: 600; font-size: 0.95rem; }
      nav { display: flex; gap: 1.1rem; flex-wrap: wrap; flex: 1; }
      nav a { text-decoration: none; color: var(--ink-soft); }
      nav a:hover, nav a[aria-current] { color: var(--ink); }
      nav a[aria-current] { box-shadow: inset 0 -2px 0 var(--amber); }
      .slash { color: var(--amber); opacity: 0.7; }
      .theme {
        background: none; border: 0; color: var(--ink-soft); cursor: pointer; font-size: 1.1rem; padding: 0.2rem;
      }
      .theme:hover { color: var(--amber); }
      @media (max-width: 600px) {
        .top { gap: 0.6rem 1rem; }
        .theme { margin-left: auto; }
        nav { order: 3; flex-basis: 100%; gap: 0.9rem; }
      }
      main { min-height: 70vh; }
      .foot {
        display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
        border-top: 1px dashed var(--rule); margin-top: 5rem; padding-top: 1.5rem; padding-bottom: 2.5rem;
      }
    </style>
  </body>
</html>
