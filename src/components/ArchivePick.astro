---
import type { FeedItem } from '../lib/feed';
import RelativeTime from './RelativeTime.astro';
interface Props { items: FeedItem[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="archive" aria-labelledby="arch-h">
    <h2 id="arch-h" class="label">from the archive</h2>
    <ul data-archive>
      {items.map((it, i) => (
        <li hidden={i !== 0}>
          <span class="mono soft">{it.kind} · <RelativeTime date={it.date} /></span>
          <a href={it.url}>{it.title}</a>
        </li>
      ))}
    </ul>
    <button class="btn" type="button" data-reshuffle><span class="prompt">↻</span> another</button>
  </section>
)}
<script>
  const list = document.querySelector('[data-archive]');
  if (list) {
    const lis = [...list.children] as HTMLElement[];
    let cur = -1;
    const show = () => {
      let n = Math.floor(Math.random() * lis.length);
      if (lis.length > 1 && n === cur) n = (n + 1) % lis.length;
      lis.forEach((li, i) => (li.hidden = i !== n));
      cur = n;
    };
    show();
    document.querySelector('[data-reshuffle]')?.addEventListener('click', show);
  }
</script>
<style>
  .archive { border: 1px dashed var(--amber); border-radius: 6px; padding: 1.1rem 1.25rem; transform: rotate(0.5deg); }
  h2 { margin: 0 0 0.6rem; }
  ul { list-style: none; padding: 0; margin: 0 0 0.9rem; }
  li { display: flex; flex-direction: column; gap: 0.2rem; }
  li a { font-size: 1.25rem; font-style: italic; text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .mono { font-size: 0.72rem; }
</style>
