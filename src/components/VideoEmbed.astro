---
// Lazy video: shows nothing heavy until it scrolls into view.
interface Props { src: string; title: string; }
const { src, title } = Astro.props;
---
<div class="video">
  <iframe src={src} title={title} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>
<style>
  .video { aspect-ratio: 16 / 9; background: #111; }
  iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
