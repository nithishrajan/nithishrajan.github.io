---
import { greetings } from '../data/greetings';
---
<h1 class="greeting">
  <span class="prompt mono amber" aria-hidden="true">&gt;</span>
  <span data-greeting data-lines={JSON.stringify(greetings)}>{greetings[0]}</span><span class="cursor" aria-hidden="true"></span>
</h1>
<script>
  const el = document.querySelector<HTMLElement>('[data-greeting]');
  if (el) {
    const lines: string[] = JSON.parse(el.dataset.lines || '[]');
    const pick = lines[Math.floor(Math.random() * lines.length)];
    // type it out, a little unevenly, like a person
    el.textContent = '';
    let i = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tick = () => {
      el.textContent = pick.slice(0, ++i);
      if (i < pick.length) setTimeout(tick, reduce ? 0 : 25 + Math.random() * 70);
    };
    tick();
  }
</script>
<style>
  .greeting { font-size: clamp(1.8rem, 5vw, 2.8rem); font-style: italic; margin: 2.5rem 0 0.75rem; min-height: 1.3em; }
  @media (max-width: 600px) { .greeting { min-height: 2.6em; } }
  .prompt { font-style: normal; font-size: 0.6em; vertical-align: 0.25em; margin-right: 0.3rem; }
</style>
