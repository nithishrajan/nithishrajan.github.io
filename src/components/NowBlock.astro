---
import { getEntry } from 'astro:content';
import RelativeTime from './RelativeTime.astro';
const now = (await getEntry('now', 'now'))!.data;
const rows: [string, string][] = [
  ['reading', now.reading],
  ['last seen', now.lastPlace],
  ['working on', now.workingOn],
  ...(now.listening ? [['listening', now.listening] as [string, string]] : []),
];
---
<section class="now" aria-labelledby="now-h">
  <h2 id="now-h" class="label">now</h2>
  <dl class="mono">
    {rows.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    <dt>local time</dt>
    <dd><span data-localtime data-tz={now.timezone}>—</span></dd>
  </dl>
  <p class="mono soft updated">updated <RelativeTime date={now.updated} /></p>
</section>
<script>
  const el = document.querySelector<HTMLElement>('[data-localtime]');
  if (el) {
    const tz = el.dataset.tz!;
    const render = () => {
      const t = new Date().toLocaleTimeString('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).toLowerCase();
      const h = Number(new Date().toLocaleString('en-US', { timeZone: tz, hour: 'numeric', hour12: false }));
      const mood = h < 6 ? 'probably asleep' : h < 11 ? 'coffee hours' : h < 17 ? 'out and about' : h < 22 ? 'winding down' : 'up too late';
      el.textContent = `it's ${t} here · ${mood}`;
    };
    render();
    setInterval(render, 30_000);
  }
</script>
<style>
  .now { background: var(--paper-2); border: 1px solid var(--rule); border-radius: 6px; padding: 1.1rem 1.25rem; box-shadow: var(--shadow); transform: rotate(-0.4deg); }
  h2 { margin: 0 0 0.75rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1rem; margin: 0; font-size: 0.82rem; }
  dt { color: var(--amber); }
  dd { margin: 0; }
  .updated { margin: 0.9rem 0 0; font-size: 0.7rem; }
</style>
