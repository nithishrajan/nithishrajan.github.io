---
interface Props { label?: string; }
const { label = 'surprise me' } = Astro.props;
---
<button class="btn surprise" type="button" data-surprise>
  <span class="prompt">$</span> {label} <kbd>r</kbd>
</button>
<style>
  kbd { margin-left: 0.3rem; font-size: 0.7rem; color: var(--ink-soft); }
</style>
