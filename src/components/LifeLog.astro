---
import type { FeedItem } from '../lib/feed';
import RelativeTime from './RelativeTime.astro';
interface Props { items: FeedItem[]; }
const { items } = Astro.props;
---
<ol class="log mono">
  {items.map((it) => (
    <li>
      <span class="hash">{it.hash}</span>
      <span class={`kind k-${it.kind}`}>{it.kind}</span>
      <a href={it.url} class="title">{it.title}</a>
      <span class="meta soft">{it.note && <>{it.note} · </>}<RelativeTime date={it.date} /></span>
    </li>
  ))}
</ol>
<style>
  .log { list-style: none; padding: 0; margin: 0; font-size: 0.82rem; }
  li {
    display: grid;
    grid-template-columns: 4.5rem 4.2rem 1fr;
    gap: 0.25rem 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--rule);
    align-items: baseline;
  }
  .hash { color: var(--amber); }
  .kind { color: var(--ink-soft); }
  .k-post { color: var(--terracotta); }
  .title { text-decoration: none; font-family: var(--serif); font-size: 1.02rem; }
  .title:hover { text-decoration: underline; }
  .meta { grid-column: 3; font-size: 0.72rem; }
  @media (max-width: 520px) {
    li { grid-template-columns: 4.2rem 1fr; }
    .hash { display: none; }
    .meta { grid-column: 2; }
  }
</style>
